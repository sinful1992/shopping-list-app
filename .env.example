# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# App Configuration
APP_NAME=Family Shopping List
APP_VERSION=1.0.0

# Google Sign-In
# Get this from Firebase Console > Authentication > Sign-in method > Google > Web client ID
GOOGLE_WEB_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# Supabase (edge functions, urgent items, subscription tier)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# RevenueCat
# Release builds need the Android public key (starts with goog_):
# RevenueCat dashboard > Project settings > API keys > Android.
# A test_ key works only in debug builds. A release build with a test_ key
# shows "Wrong API Key" and closes on start (RevenueCat does this on purpose).
REVENUECAT_ANDROID_API_KEY=
