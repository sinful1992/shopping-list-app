rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipt images - only family group members can read/write
    // The familyGroupId custom claim is set by Cloud Function when user joins/creates a group
    match /receipts/{familyGroupId}/{allPaths=**} {
      allow read, delete: if request.auth != null
        && request.auth.token.familyGroupId == familyGroupId;
    }

    // Uploads (SH-5, audit 137): only the app's shape receipts/{group}/{list}/{file},
    // a photo type, more than 0 bytes and at most 15 MB (the app's captures are a
    // few MB). App builds before 1.53.25 send no type, so the native side may send
    // application/octet-stream; that is accepted only for the app's own file name
    // ({milliseconds}.jpg), so old phones keep uploading.
    match /receipts/{familyGroupId}/{listId}/{fileName} {
      allow create, update: if request.auth != null
        && request.auth.token.familyGroupId == familyGroupId
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
            || (request.resource.contentType == 'application/octet-stream'
                && fileName.matches('[0-9]+[.]jpg')));
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
