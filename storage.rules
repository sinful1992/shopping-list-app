rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipt images - only family group members can read/write
    // The familyGroupId custom claim is set by Cloud Function when user joins/creates a group
    match /receipts/{familyGroupId}/{allPaths=**} {
      allow read, delete: if request.auth != null
        && request.auth.token.familyGroupId == familyGroupId;
    }

    // Uploads (SH-5, audit 137): only the app's shape receipts/{group}/{list}/{file},
    // an image, more than 0 bytes and under 15 MB (the app's captures are a few MB).
    match /receipts/{familyGroupId}/{listId}/{fileName} {
      allow create, update: if request.auth != null
        && request.auth.token.familyGroupId == familyGroupId
        && request.resource.size > 0
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
