{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "index.js!",
    "App.tsx!",
    "scripts/**/*.{ts,js,mjs}"
  ],
  "project": [
    "index.js!",
    "App.tsx!",
    "src/**/*.{ts,tsx}!",
    "scripts/**/*.{ts,js,mjs}"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@babel/preset-env",
    "@react-native/gradle-plugin",
    "postinstall-postinstall",
    "metro-config",
    "@env"
  ],
  "tags": [
    "-internal"
  ]
}
